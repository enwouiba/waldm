{
  "name": "waldm",
  "productName": "WalDM",
  "version": "0.1.0",
  "description": "WalDM — a fast multi-segment download manager (IDM-style) with browser integration, video capture and scheduling.",
  "author": "WalChat",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node launch.js",
    "start:direct": "electron .",
    "engine:test": "node src/main/engineCli.js",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "net.walchat.waldm",
    "productName": "WalDM",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!**/*.md"
    ],
    "extraResources": [
      { "from": "extension", "to": "extension" }
    ],
    "linux": { "target": ["AppImage", "deb"], "category": "Network", "icon": "assets/icon.png" },
    "win": { "target": ["nsis"], "icon": "assets/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WalDM"
    },
    "mac": { "target": ["dmg"], "category": "public.app-category.utilities", "icon": "assets/icon.png" }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
